{
  "manifest_version": 2,
  "name": "restoreSubCount",
  "description": "restore the subscriber count on old Reddit",
  "version": "0.0.1",
  "icons": {
    "64": "icons/icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://old.reddit.com/r/*",
        "https://www.reddit.com/r/*"
      ],
      "js": ["content_script.js"]
    }
  ]
}
